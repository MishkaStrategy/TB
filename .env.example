TELEGRAM_TOKEN=
BITUNIX_API_KEY=
BITUNIX_SECRET=
ALLOWED_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_IDS=123456789

# Production-safe default: only IDs from the allow-list can use the bot.
PUBLIC_ACCESS_ENABLED=false

# Resource guards for the shared Bitunix stream and Telegram delivery queue.
MAX_ACTIVE_SYMBOLS=100
MAX_SYMBOLS_PER_USER=20
FVG_DELIVERY_QUEUE_SIZE=1000
FVG_PROCESS_RESTART_STALE_SECONDS=1000
HEALTH_WRITE_INTERVAL_SECONDS=30
BITUNIX_REQUESTS_PER_SECOND=8

# Low-noise operational alerts sent to ADMIN_TELEGRAM_IDS.
HEALTH_ALERT_INTERVAL_SECONDS=60
HEALTH_ALERT_STALE_WS_SECONDS=180
HEALTH_ALERT_OUTBOX_THRESHOLD=100
HEALTH_ALERT_COOLDOWN_SECONDS=1800

# Optional FVG lifecycle foundation. It is disabled by default and does not
# change Telegram messages while shadow mode is enabled. Emergency rollback:
# set FVG_LIFECYCLE_ENABLED=false and restart the service.
FVG_LIFECYCLE_ENABLED=false
FVG_LIFECYCLE_SHADOW_MODE=true
FVG_LIFECYCLE_SYNC_INTERVAL_SECONDS=30
FVG_LIFECYCLE_MAX_AGE_BARS=96
FVG_LIFECYCLE_APPROACHING_ZONE_WIDTHS=1
FVG_LIFECYCLE_INVALIDATION_BUFFER_RATIO=0
