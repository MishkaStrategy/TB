# Bot API-only deployment: this is the only Telegram credential required.
# Do not add Telegram App API_ID/API_HASH, Telethon, Pyrogram, or session strings.
TELEGRAM_TOKEN=

BITUNIX_API_KEY=
BITUNIX_SECRET=
ALLOWED_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_IDS=123456789

# Production-safe default: only IDs from the allow-list can use the bot.
PUBLIC_ACCESS_ENABLED=false

# Telegram Mini App API is disabled until deployment is explicitly configured.
MINI_APP_BACKEND_ENABLED=false
MINI_APP_BACKEND_HOST=127.0.0.1
MINI_APP_BACKEND_PORT=8080
MINI_APP_AUTH_MAX_AGE_SECONDS=3600
# Comma-separated exact origins when frontend and API use different origins.
# DuckDNS example: https://tb-mini-app.duckdns.org
MINI_APP_ALLOWED_ORIGINS=

# Additive Telegram delivery rollout. Enable tracking first, then suppression.
DELIVERY_STATUS_TRACKING_ENABLED=false
USER_BLOCK_STATUS_ENABLED=false

# Explicit Outbox V2 rollout. Keep disabled until delivery status is stable.
OUTBOX_RETRY_POLICY_ENABLED=false
OUTBOX_EXPIRATION_ENABLED=false
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_BACKOFF_SECONDS=5
OUTBOX_MAX_BACKOFF_SECONDS=900
OUTBOX_JITTER_RATIO=0.2
OUTBOX_PROCESSING_LEASE_SECONDS=120
OUTBOX_TERMINAL_RETENTION_DAYS=30
OUTBOX_DEFAULT_TTL_SECONDS=3600

# Read-only SQLite growth snapshots. Heavy diagnostics remain disabled.
DATABASE_OBSERVABILITY_ENABLED=false
DATABASE_OBSERVABILITY_INTERVAL_SECONDS=3600
DATABASE_OBSERVABILITY_RETENTION_DAYS=90
DATABASE_OBSERVABILITY_ROW_COUNTS_ENABLED=false
DATABASE_OBSERVABILITY_INTEGRITY_CHECK_ENABLED=false

# Persistent cross-process job leases and stale-job reporting.
BACKGROUND_TASK_REGISTRY_ENABLED=false
BACKGROUND_TASK_WATCHDOG_ENABLED=false
BACKGROUND_TASK_HISTORY_RETENTION_DAYS=30
BACKGROUND_TASK_HEARTBEAT_SECONDS=30
BACKGROUND_TASK_MIN_LEASE_SECONDS=120
BACKGROUND_TASK_WATCHDOG_INTERVAL_SECONDS=60
BACKGROUND_TASK_STALE_MULTIPLIER=3

# PTB lifecycle persistence and bounded post_stop delivery drain.
RUNTIME_LIFECYCLE_ENABLED=false
GRACEFUL_SHUTDOWN_ENABLED=false
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=25
RUNTIME_LIFECYCLE_HISTORY_RETENTION_DAYS=30

# Archive old terminal FVG history before runtime retention deletes it.
FVG_HISTORY_ARCHIVE_ENABLED=false
FVG_HISTORY_ARCHIVE_PATH=data/archive/fvg_history.sqlite3
FVG_HISTORY_RETENTION_DAYS=90
FVG_HISTORY_ARCHIVE_BATCH_SIZE=500
FVG_HISTORY_ARCHIVE_MAX_BATCHES=10

# Resource guards for shared multi-exchange FVG calculations and Telegram delivery.
MAX_ACTIVE_SYMBOLS=100
MAX_SYMBOLS_PER_USER=10
FVG_DELIVERY_QUEUE_SIZE=1000
FVG_PROCESS_RESTART_STALE_SECONDS=1000
# Opt-in: request SIGTERM so PTB post_stop can drain before systemd restarts.
FVG_PROCESS_GRACEFUL_RESTART_ENABLED=false
# Optional persistent cross-process restart window/cooldown.
FVG_PROCESS_RESTART_GUARD_ENABLED=false
FVG_PROCESS_RESTART_MAX_REQUESTS=3
FVG_PROCESS_RESTART_WINDOW_SECONDS=3600
FVG_PROCESS_RESTART_COOLDOWN_SECONDS=3600
FVG_PROCESS_RESTART_HISTORY_RETENTION_DAYS=30
HEALTH_WRITE_INTERVAL_SECONDS=30
BITUNIX_REQUESTS_PER_SECOND=8

# Low-noise operational alerts sent to ADMIN_TELEGRAM_IDS.
HEALTH_ALERT_INTERVAL_SECONDS=60
HEALTH_ALERT_STALE_WS_SECONDS=180
HEALTH_ALERT_OUTBOX_THRESHOLD=100
HEALTH_ALERT_COOLDOWN_SECONDS=1800
